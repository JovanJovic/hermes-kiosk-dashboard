[Unit]
Description=Hermes kiosk activity hub (read-only)
After=default.target

[Service]
Type=simple
User=%u
WorkingDirectory=%h/hermes-kiosk-dashboard
ExecStart=/usr/bin/python3 %h/hermes-kiosk-dashboard/server/hub.py --port 9121
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
